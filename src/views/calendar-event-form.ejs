<%- include('partials/head') %><section class="pagehead"><div><p class="eyebrow">KALENDÁŘ</p><h1><%= event?'Upravit událost':'Nová událost' %></h1></div></section>
<form class="card form" id="calendar-event-form" data-id="<%= event?.id??'' %>" data-csrf="<%= csrf %>"><div class="formgrid">
<label>Název<input name="title" required value="<%= event?.title??'' %>"></label><label>Typ<select name="eventType"><% ['VACATION','SICKNESS','TRAINING','SHIFT_CHANGE','MEETING','TECHNICAL_CHECK','SERVICE','INSPECTION','NOTE','OTHER'].forEach(x=>{%><option <%=event?.eventType===x?'selected':''%>><%=x%></option><%})%></select></label>
<label>Začátek<input type="datetime-local" name="startAt" required value="<%= fmtInput(event?.startAt) %>"></label><label>Konec<input type="datetime-local" name="endAt" required value="<%= fmtInput(event?.endAt) %>"></label>
<label>Osoba<select name="personId"><option value="">Bez osoby</option><%people.forEach(p=>{%><option value="<%=p.id%>" <%=event?.personId===p.id?'selected':''%>><%=p.displayName%></option><%})%></select></label><label>Barva<input type="color" name="color" value="<%=event?.color??'#29c4df'%>"></label>
<label>Priorita<select name="priority"><%['LOW','NORMAL','IMPORTANT','CRITICAL'].forEach(x=>{%><option <%=event?.priority===x?'selected':''%>><%=x%></option><%})%></select></label><label>Stav<select name="status"><%['ACTIVE','CANCELLED','COMPLETED'].forEach(x=>{%><option <%=event?.status===x?'selected':''%>><%=x%></option><%})%></select></label>
<label>Opakování<select name="recurrenceType"><%['NONE','DAILY','WEEKLY','MONTHLY','YEARLY'].forEach(x=>{%><option <%=event?.recurrenceType===x?'selected':''%>><%=x%></option><%})%></select></label><label>Interval opakování<input type="number" name="recurrenceInterval" min="1" value="<%=event?.recurrenceInterval??1%>"></label>
<label>Konec opakování<input type="date" name="recurrenceUntil" value="<%=event?.recurrenceUntil?.toISOString().slice(0,10)??''%>"></label><label>Počet opakování<input type="number" name="recurrenceCount" min="1" value="<%=event?.recurrenceCount??''%>"></label>
</div><label>Směny<div class="checks"><%['A','B','C','ALL'].forEach(x=>{%><label class="check"><input type="checkbox" name="shifts" value="<%=x%>" <%=event?.shifts?.some(s=>s.shift===x)||(!event&&x==='ALL')?'checked':''%>> <%=x%></label><%})%></div></label>
<label>Popis<textarea name="description"><%=event?.description??''%></textarea></label><label>Interní poznámka<textarea name="internalNote"><%=event?.internalNote??''%></textarea></label>
<div class="checks"><label class="check"><input type="checkbox" name="allDay" <%=event?.allDay?'checked':''%>> Celý den</label><label class="check"><input type="checkbox" name="notifyEsp" <%=event?.notifyEsp?'checked':''%>> Upozornit ESP32</label><label class="check"><input type="checkbox" name="notifyOnStartDay" <%=event?.notifyOnStartDay?'checked':''%>> Také v den začátku</label><label class="check"><input type="checkbox" name="requireAcknowledgement" <%=event?.requireAcknowledgement?'checked':''%>> Vyžadovat potvrzení</label><label class="check"><input type="checkbox" name="beepEnabled" <%=event?.beepEnabled?'checked':''%>> Pípnutí</label></div>
<div class="two"><label>Upozornit předem (min)<input type="number" name="notifyBeforeMinutes" min="0" value="<%=event?.notifyBeforeMinutes??1440%>"></label><label>Doba zobrazení (s)<input type="number" name="durationSeconds" min="5" max="3600" value="<%=event?.durationSeconds??20%>"></label></div>
<div class="filters"><button class="primary">Uložit</button><%if(event){%><button type="button" class="danger" id="delete-event">Smazat</button><%}%></div></form><script src="/calendar-form.js"></script><%- include('partials/foot') %>
