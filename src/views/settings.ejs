<%- include('partials/head') %><section class="pagehead"><div><p class="eyebrow">VZDÁLENÁ KONFIGURACE</p><h1>Nastavení panelu</h1></div><span class="badge"><%= configuration?'Verze '+configuration.version+' · '+configuration.status:'Výchozí nastavení' %></span></section>
<form method="post" class="card form"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="formgrid">
<label>Interval LCD stránek (s)<input type="number" name="pageIntervalSeconds" min="2" max="300" value="<%= settings.pageIntervalSeconds %>"></label><label>Kontrola Railway (s)<input type="number" name="pollIntervalSeconds" min="10" max="300" value="<%= settings.pollIntervalSeconds %>"></label>
<label>Denní jas (%)<input type="number" name="dayBrightness" min="0" max="100" value="<%= settings.dayBrightness %>"></label><label>Noční jas (%)<input type="number" name="nightBrightness" min="0" max="100" value="<%= settings.nightBrightness %>"></label>
<label>Začátek noci<input type="time" name="nightStart" value="<%= settings.nightStart %>"></label><label>Konec noci<input type="time" name="nightEnd" value="<%= settings.nightEnd %>"></label>
<label>Nízká baterie (%)<input type="number" name="lowBatteryPercent" value="<%= settings.lowBatteryPercent %>"></label><label>Kritická baterie (%)<input type="number" name="criticalBatteryPercent" value="<%= settings.criticalBatteryPercent %>"></label></div>
<div class="checks"><label class="check"><input type="checkbox" name="backlightEnabled" <%= settings.backlightEnabled?'checked':'' %>> Podsvícení</label><label class="check"><input type="checkbox" name="buzzerEnabled" <%= settings.buzzerEnabled?'checked':'' %>> Bzučák</label></div>
<label>Pořadí LCD stránek<input name="pages" value="<%= Array.isArray(settings.pages)?settings.pages.join(', '):settings.pages %>"></label><p class="muted">Uložení vytvoří novou verzi. Za použitou se označí až po potvrzení ESP32.</p><button class="primary">Vytvořit novou konfiguraci</button></form><%- include('partials/foot') %>
