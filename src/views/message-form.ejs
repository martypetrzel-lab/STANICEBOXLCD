<%- include('partials/head') %><section class="pagehead"><div><p class="eyebrow">NOVÁ KOMUNIKACE</p><h1>Vytvořit zprávu</h1></div></section>
<form method="post" action="/messages" class="split-form" id="message-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="card form">
<label>Nadpis<input name="title" maxlength="100" required></label><label>Text<textarea name="body" rows="6" maxlength="4000" required></textarea></label><div class="two"><label>Priorita<select name="priority"><option>NORMAL</option><option>IMPORTANT</option><option>CRITICAL</option></select></label><label>Režim<select name="displayMode"><option>ROTATION</option><option>IMMEDIATE</option><option>STICKY</option><option>FULLSCREEN</option></select></label></div>
<div class="two"><label>Doba zobrazení (s)<input type="number" name="durationSeconds" value="30" min="5" max="3600"></label><label>Začátek<input type="datetime-local" name="startsAt"></label></div><label>Konec platnosti<input type="datetime-local" name="expiresAt"></label>
<label class="check"><input type="checkbox" name="beepEnabled"> Pípnutí</label><label class="check"><input type="checkbox" name="requireAcknowledgement"> Vyžadovat potvrzení tlačítkem</label><button class="primary">Uložit a zařadit</button></div>
<aside class="card"><div class="card-title">Živý náhled LCD 20×4</div><div class="lcd" id="lcd"><span></span><span></span><span></span><span></span></div><p class="muted">Pro displej se automaticky použije text bez diakritiky a bezpečné zalomení.</p></aside></form>
<%- include('partials/foot') %>
