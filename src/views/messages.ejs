<%- include('partials/head') %><section class="pagehead"><div><p class="eyebrow">KOMUNIKACE</p><h1>Zprávy</h1></div><a class="button primary" href="/messages/new">+ Nová zpráva</a></section>
<form class="filters"><select name="status"><option value="">Všechny stavy</option><% for(const s of ['PENDING','DELIVERED','DISPLAYED','ACKNOWLEDGED','COMPLETED','CANCELLED','EXPIRED','ERROR']){ %><option <%= filter.status===s?'selected':'' %>><%= s %></option><% } %></select>
<select name="priority"><option value="">Všechny priority</option><% for(const p of ['NORMAL','IMPORTANT','CRITICAL']){ %><option <%= filter.priority===p?'selected':'' %>><%= p %></option><% } %></select><button>Filtrovat</button></form>
<div class="list"><% if(!messages.length){ %><div class="empty">Zatím tu není žádná zpráva.</div><% } messages.forEach(m=>{ %><article class="row"><div><span class="badge priority-<%= m.priority.toLowerCase() %>"><%= m.priority %></span><h3><%= m.title %></h3><p><%= m.body %></p><small><%= fmt(m.createdAt) %> · <%= m.displayMode %></small></div><div><span class="badge"><%= m.status %></span><form method="post" action="/messages/<%= m.id %>/repeat"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Zopakovat</button></form><% if(m.status==='PENDING'){%><form method="post" action="/messages/<%= m.id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Zrušit</button></form><%}%><form method="post" action="/messages/<%= m.id %>/delete" data-confirm="Opravdu smazat zprávu?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="danger">Smazat</button></form></div></article><% }) %></div>
<%- include('partials/foot') %>
