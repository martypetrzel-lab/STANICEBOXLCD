<%- include('partials/head') %><section class="pagehead"><div><p class="eyebrow">PROVOZNÍ DENÍK</p><h1>Události</h1></div></section><article class="card"><div class="list"><% if(!events.length){%><div class="empty">Panel zatím neposlal žádnou událost.</div><%} events.forEach(e=>{ %><div class="row"><div><span class="badge priority-<%= e.severity==='CRITICAL'?'critical':e.severity==='WARNING'?'important':'normal' %>"><%= e.severity %></span><h3><%= e.message %></h3><small><%= e.type %> · <%= fmt(e.createdAt) %></small></div></div><% }) %></div></article><%- include('partials/foot') %>
