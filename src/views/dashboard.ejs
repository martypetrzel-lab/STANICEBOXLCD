<%- include('partials/head') %>
<section class="hero"><div><p class="eyebrow">PŘEHLED PANELU</p><h1><span id="clock">--:--:--</span><small id="date"></small></h1></div>
<span id="online" class="badge <%= online?'ok':'bad' %>"><i></i><%= online?'Online':'Offline' %></span></section>
<div class="grid">
<article class="card accent"><div class="card-title">Aktuální směna</div><div class="shift"><%= shift.shift %></div><dl><div><dt>Následuje</dt><dd><%= shift.next %></dd></div><div><dt>Konec směny</dt><dd><%= fmt(shift.end) %></dd></div><div><dt>Zbývá</dt><dd id="countdown" data-end="<%= shift.end.toISOString() %>">—</dd></div></dl>
<% if(device?.currentShift && device.currentShift!==shift.shift){ %><p class="warning">Směna hlášená panelem se liší.</p><% } %></article>
<article class="card"><div class="card-title">Počasí · <%= location %></div><% if(weather){ %><div class="value"><%= weather.temperature %> °C</div><h3><%= weather.description %></h3><dl><div><dt>Pocitově</dt><dd><%= weather.apparentTemperature %> °C</dd></div><div><dt>Vítr</dt><dd><%= weather.windSpeed %> km/h</dd></div></dl><% if(weather.stale){%><p class="warning">Zobrazeny poslední známé údaje.</p><%}%><% }else{ %><p>Počasí není momentálně dostupné.</p><% } %></article>
<article class="card"><div class="card-title">Dnešní svátek</div><div class="value small"><%= nameday %></div><p class="muted">Aktualizováno pro český kalendář</p></article>
<article class="card"><div class="card-title">Zařízení</div><div class="statusline"><span class="dot <%= online?'ok-bg':'bad-bg' %>"></span><strong><%= device?.name??'stanicebox-01' %></strong></div>
<dl><div><dt>Poslední kontakt</dt><dd><%= fmt(device?.lastSeenAt) %></dd></div><div><dt>Firmware</dt><dd><%= device?.firmwareVersion??'—' %></dd></div><div><dt>Lokální IP</dt><dd><%= device?.localIp??'—' %></dd></div><div><dt>Wi-Fi</dt><dd><%= device?.wifiRssi!=null?device.wifiRssi+' dBm':'—' %></dd></div></dl></article>
<article class="card"><div class="card-title">Napájení a systém</div><dl><div><dt>Zdroj</dt><dd><%= device?.powerSource??'—' %></dd></div><div><dt>Baterie</dt><dd><%= device?.batteryPercent!=null?device.batteryPercent+' %':'—' %></dd></div><div><dt>Napětí</dt><dd><%= device?.batteryVoltage!=null?device.batteryVoltage+' V':'—' %></dd></div><div><dt>Volná paměť</dt><dd><%= device?.freeHeap!=null?Math.round(device.freeHeap/1024)+' kB':'—' %></dd></div><div><dt>Uptime</dt><dd><%= device?.uptimeSeconds??'—' %> s</dd></div><div><dt>LCD stránka</dt><dd><%= device?.currentScreen??'—' %></dd></div></dl></article>
<article class="card wide"><div class="card-title">Poslední aktivita</div><div class="activity"><div><span class="icon">↯</span><p><strong><%= lastEvent?.message??device?.lastEvent??'Zatím žádná událost' %></strong><small><%= fmt(lastEvent?.createdAt) %></small></p></div><div><span class="icon">✉</span><p><strong><%= lastMessage?.title??'Zatím žádná zpráva' %></strong><small><%= lastMessage?.status??'—' %></small></p></div></div></article></div>
<section class="pagehead calendar-head"><div><p class="eyebrow">PERSONÁLNÍ KALENDÁŘ</p><h2>Dnes a nejbližší dny</h2></div><a class="button primary" href="/calendar/events/new">+ Nová událost</a></section>
<div class="grid calendar-summary"><article class="card"><div class="card-title">Dnešní události</div><% if(!todayEvents.length){%><p class="muted">Dnes bez událostí.</p><%} todayEvents.forEach(e=>{%><div class="mini-event"><i style="background:<%= e.color %>"></i><div><strong><%= e.title %></strong><small><%= e.person?.displayName??e.shifts.map(s=>s.shift).join(', ') %></small></div></div><%})%></article>
<article class="card"><div class="card-title">Aktuální nepřítomnosti</div><% if(!absences.length){%><p class="muted">Nikdo není evidovaný jako nepřítomný.</p><%} absences.forEach(e=>{%><div class="mini-event"><i style="background:<%= e.color %>"></i><div><strong><%= e.person?.displayName??e.title %></strong><small><%= e.eventType %> · do <%= fmt(e.endAt) %></small></div></div><%})%></article>
<article class="card"><div class="card-title">Upozornění ESP</div><div class="value"><%= pendingNotifications %></div><p class="muted">čeká na doručení</p><a href="/notifications">Otevřít historii →</a></article>
<article class="card wide"><div class="card-title">Následujících 7 dnů</div><% if(!upcomingEvents.length){%><p class="muted">Žádné plánované události.</p><%} upcomingEvents.forEach(e=>{%><div class="mini-event"><i style="background:<%= e.color %>"></i><div><strong><%= e.title %></strong><small><%= fmt(e.startAt) %> · <%= e.person?.displayName??e.shifts.map(s=>s.shift).join(', ') %></small></div></div><%})%></article></div>
<%- include('partials/foot') %>
