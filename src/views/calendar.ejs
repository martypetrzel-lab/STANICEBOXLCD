<%- include('partials/head') %><section class="pagehead"><div><p class="eyebrow">PLÁNOVÁNÍ</p><h1>Kalendář</h1></div><a class="button primary" href="/calendar/events/new">+ Nová událost</a></section>
<div class="calendar-filters card"><select id="filter-shift"><option value="">Všechny směny</option><option>A</option><option>B</option><option>C</option></select><select id="filter-person"><option value="">Všechny osoby</option><% people.forEach(p=>{%><option value="<%=p.id%>"><%=p.displayName%></option><%})%></select><select id="filter-type"><option value="">Všechny typy</option><option>VACATION</option><option>SICKNESS</option><option>TRAINING</option><option>SHIFT_CHANGE</option><option>MEETING</option><option>TECHNICAL_CHECK</option><option>SERVICE</option><option>INSPECTION</option><option>NOTE</option><option>OTHER</option></select><select id="filter-status"><option value="">Všechny stavy</option><option>ACTIVE</option><option>CANCELLED</option><option>COMPLETED</option></select></div>
<div class="card calendar-card"><div id="calendar" data-csrf="<%= csrf %>"></div></div>
<script src="/vendor/fullcalendar/index.global.min.js"></script><script src="/calendar.js"></script><%- include('partials/foot') %>
