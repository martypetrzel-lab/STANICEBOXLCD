<%- include('partials/head') %><section class="pagehead"><div><p class="eyebrow">PERSONÁL</p><h1>Lidé</h1></div><button class="primary" id="new-person">+ Přidat osobu</button></section>
<div class="people-grid"><%people.forEach(p=>{%><article class="card person-card" data-person="<%= encodeURIComponent(JSON.stringify(p)) %>"><i style="background:<%=p.color%>"></i><h3><%=p.displayName%></h3><p><%=p.firstName%> <%=p.lastName%> · směna <%=p.shift%></p><small><%=p.email??''%> <%=p.phone??''%></small><span class="badge <%=p.active?'ok':'bad'%>"><%=p.active?'Aktivní':'Neaktivní'%></span><button class="edit-person">Upravit</button></article><%})%></div>
<dialog id="person-dialog"><form id="person-form" class="form" data-csrf="<%=csrf%>"><input type="hidden" name="id"><h2>Osoba</h2><div class="two"><label>Jméno<input name="firstName" required></label><label>Příjmení<input name="lastName" required></label></div><label>Zobrazované jméno<input name="displayName" required></label><div class="two"><label>Směna<select name="shift"><option>A</option><option>B</option><option>C</option></select></label><label>Barva<input type="color" name="color" value="#29c4df"></label></div><div class="two"><label>E-mail<input type="email" name="email"></label><label>Telefon<input name="phone"></label></div><label>Poznámka<textarea name="note"></textarea></label><label class="check"><input type="checkbox" name="active" checked> Aktivní</label><div class="filters"><button class="primary">Uložit</button><button type="button" id="close-person">Zavřít</button><button type="button" class="danger" id="delete-person">Odstranit</button></div></form></dialog><script src="/people.js"></script><%- include('partials/foot') %>
