<%- include('partials/head') %><section class="pagehead"><div><p class="eyebrow">OTA PŘÍPRAVA</p><h1>Firmware</h1></div></section>
<form method="post" enctype="multipart/form-data" class="card form"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="two"><label>Verze<input name="version" required maxlength="50"></label><label>BIN soubor<input type="file" name="binary" accept=".bin,application/octet-stream" required></label></div><label>Poznámka<textarea name="notes"></textarea></label><button class="primary">Nahrát firmware</button></form>
<div class="list"><% releases.forEach(f=>{ %><article class="row"><div><span class="badge <%= f.active?'ok':'' %>"><%= f.active?'AKTIVNÍ':'NEAKTIVNÍ' %></span><h3><%= f.version %></h3><p><%= f.notes %></p><small>SHA-256: <%= f.sha256 %> · <%= fmt(f.createdAt) %></small></div><% if(!f.active){ %><form method="post" action="/firmware/<%= f.id %>/activate" data-confirm="Zpřístupnit tuto verzi zařízení?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Aktivovat</button></form><% } %></article><% }) %></div><%- include('partials/foot') %>
