<%- include('partials/head') %><section class="pagehead"><div><p class="eyebrow">SPRÁVA HARDWARU</p><h1>Zařízení</h1></div></section>
<div class="grid"><article class="card"><div class="card-title">Identita</div><dl><div><dt>ID</dt><dd><%= device?.deviceId %></dd></div><div><dt>Název</dt><dd><%= device?.name %></dd></div><div><dt>Povoleno</dt><dd><%= device?.enabled?'Ano':'Ne' %></dd></div><div><dt>Poslední kontakt</dt><dd><%= fmt(device?.lastSeenAt) %></dd></div></dl></article>
<article class="card wide"><div class="card-title">Vzdálená akce</div><form method="post" action="/device/commands" class="command"><input type="hidden" name="_csrf" value="<%= csrf %>"><select name="type"><% commandTypes.forEach(c=>{ %><option><%= c %></option><% }) %></select><button class="primary" data-danger-command>Zařadit příkaz</button></form><p class="muted">Panel si příkaz stáhne při příští kontrole. Restart vyžaduje potvrzení.</p></article></div>
<article class="card"><div class="card-title">Historie příkazů</div><div class="list"><% commands.forEach(c=>{ %><div class="row"><div><h3><%= c.type %></h3><small><%= fmt(c.createdAt) %></small></div><div><span class="badge"><%= c.status %></span><% if(c.status==='QUEUED'){%><form method="post" action="/device/commands/<%= c.id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Zrušit</button></form><%}%></div></div><% }) %></div></article><%- include('partials/foot') %>
