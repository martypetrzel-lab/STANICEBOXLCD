generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Shift {
  A
  B
  C
}

enum Priority {
  NORMAL
  IMPORTANT
  CRITICAL
}

enum DisplayMode {
  ROTATION
  IMMEDIATE
  STICKY
  FULLSCREEN
}

enum MessageStatus {
  PENDING
  DELIVERED
  DISPLAYED
  ACKNOWLEDGED
  COMPLETED
  CANCELLED
  EXPIRED
  ERROR
}

enum ConfigStatus {
  PENDING
  DOWNLOADED
  APPLIED
  FAILED
}

enum CommandStatus {
  QUEUED
  DOWNLOADED
  EXECUTED
  FAILED
  EXPIRED
  CANCELLED
}

enum Severity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Device {
  id              String                @id @default(uuid()) @db.Uuid
  deviceId        String                @unique
  name            String
  apiKeyHash      String
  enabled         Boolean               @default(true)
  lastSeenAt      DateTime?
  firmwareVersion String?
  localIp         String?
  wifiSsid        String?
  wifiRssi        Int?
  batteryVoltage  Float?
  batteryPercent  Int?
  powerSource     String?
  uptimeSeconds   Int?
  freeHeap        Int?
  currentShift    Shift?
  currentScreen   String?
  backlightOn     Boolean?
  lastEvent       String?
  lastError       String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  telemetry       TelemetrySample[]
  messages        Message[]
  deliveries      MessageDelivery[]
  configurations  DeviceConfiguration[]
  commands        DeviceCommand[]
  events          DeviceEvent[]

  @@index([lastSeenAt])
}

model TelemetrySample {
  id        String   @id @default(uuid()) @db.Uuid
  deviceId  String   @db.Uuid
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  data      Json
  createdAt DateTime @default(now())

  @@index([deviceId, createdAt])
}

model Message {
  id                     String            @id @default(uuid()) @db.Uuid
  deviceId               String            @db.Uuid
  device                 Device            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  title                  String
  body                   String
  lcdTitle               String
  lcdBody                String
  lcdLines               Json?
  priority               Priority          @default(NORMAL)
  displayMode            DisplayMode       @default(ROTATION)
  durationSeconds        Int               @default(30)
  startsAt               DateTime          @default(now())
  expiresAt              DateTime?
  beepEnabled            Boolean           @default(false)
  requireAcknowledgement Boolean           @default(false)
  status                 MessageStatus     @default(PENDING)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  deliveries             MessageDelivery[]

  @@index([deviceId, status, startsAt])
}

model MessageDelivery {
  id             String    @id @default(uuid()) @db.Uuid
  messageId      String    @db.Uuid
  deviceId       String    @db.Uuid
  message        Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  device         Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deliveredAt    DateTime?
  displayedAt    DateTime?
  acknowledgedAt DateTime?
  clearedAt      DateTime?

  @@unique([messageId, deviceId])
}

model DeviceConfiguration {
  id           String       @id @default(uuid()) @db.Uuid
  deviceId     String       @db.Uuid
  device       Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  version      Int
  settings     Json
  status       ConfigStatus @default(PENDING)
  downloadedAt DateTime?
  appliedAt    DateTime?
  failedAt     DateTime?
  error        String?
  createdAt    DateTime     @default(now())

  @@unique([deviceId, version])
  @@index([deviceId, version])
}

model DeviceCommand {
  id           String        @id @default(uuid()) @db.Uuid
  deviceId     String        @db.Uuid
  device       Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  type         String
  payload      Json?
  status       CommandStatus @default(QUEUED)
  expiresAt    DateTime?
  downloadedAt DateTime?
  executedAt   DateTime?
  failedAt     DateTime?
  error        String?
  createdAt    DateTime      @default(now())

  @@index([deviceId, status, createdAt])
}

model DeviceEvent {
  id        String   @id @default(uuid()) @db.Uuid
  deviceId  String   @db.Uuid
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  type      String
  severity  Severity @default(INFO)
  message   String
  data      Json?
  createdAt DateTime @default(now())

  @@index([deviceId, createdAt])
}

model FirmwareRelease {
  id        String   @id @default(uuid()) @db.Uuid
  version   String   @unique
  notes     String?
  fileName  String
  fileUrl   String
  binary    Bytes
  sha256    String
  active    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?
  action     String
  entityType String?
  entityId   String?
  data       Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model Session {
  sid    String   @id
  sess   Json
  expire DateTime @db.Timestamp(6)

  @@index([expire])
}
